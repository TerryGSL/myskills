{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness-workflow-cli/knowledge.schema.json",
  "title": "KnowledgeCheck",
  "description": "Runtime state object written to .harness-status.json.knowledgeCheck by Stage -0.5.",
  "type": "object",
  "required": [
    "effective_index_status",
    "snapshot_id",
    "retrieval_outcome",
    "filtered_candidates",
    "known_issues",
    "relevant_knowledge_files",
    "advisory_knowledge",
    "knowledge_requirements"
  ],
  "properties": {
    "effective_index_status": { "enum": ["active", "stale", "drifted", "disabled"] },
    "snapshot_id": { "type": ["string", "null"] },
    "retrieval_outcome": { "enum": ["success", "coordinator_miss", "all_candidates_filtered"] },
    "filtered_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["manifest", "reason"],
        "properties": {
          "manifest": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "known_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "id", "domain", "reason"],
        "properties": {
          "source": { "enum": ["drifted_rule", "superseded_rule", "filtered_manifest"] },
          "id": { "type": "string" },
          "domain": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "relevant_knowledge_files": { "type": "array", "items": { "type": "string" } },
    "advisory_knowledge": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "id", "domain", "text", "weight"],
        "properties": {
          "source": { "enum": ["user_override", "expired_rule"] },
          "id": { "type": "string" },
          "domain": { "type": "string" },
          "text": { "type": "string" },
          "weight": { "const": "advisory" }
        }
      }
    },
    "knowledge_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "manifest_file", "applies_to", "requirement_text", "violation_test"],
        "properties": {
          "rule_id": { "type": "string" },
          "manifest_file": { "type": "string" },
          "applies_to": { "type": "array", "items": { "type": "string" } },
          "requirement_text": { "type": "string" },
          "violation_test": {
            "enum": [
              "must_use_wrapper",
              "must_call_component",
              "must_not_throw_raw_exception",
              "must_use_package",
              "must_not_use_pattern",
              "must_annotate_with",
              "free_form_review"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false
}
