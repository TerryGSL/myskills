{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness-workflow-cli/doctor-protocol.schema.json",
  "title": "DoctorReport",
  "description": "Output of `harness doctor --json` — health snapshot of a harness-installed repo.",
  "type": "object",
  "required": [
    "health_score",
    "checks",
    "recommendations"
  ],
  "properties": {
    "health_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "message"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "warn",
              "fail"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
