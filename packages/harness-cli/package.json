{
  "name": "harness-workflow-cli",
  "version": "0.1.0",
  "description": "CLI for harness-workflow: init / adopt / maintain / doctor / scan. Single source of truth for canonical types + schemas shared with skill markdown.",
  "bin": {
    "harness": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "type": "module",
  "files": [
    "dist",
    "resources",
    "bundled-manifest.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "generate": "tsx scripts/generate-doc-fragments.ts",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "check": "npm run build && npm run generate -- --check && npm run test"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "commander": "^11.0.0",
    "fs-extra": "^11.2.0",
    "globby": "^14.0.0",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
